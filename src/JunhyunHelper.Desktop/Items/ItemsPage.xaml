<UserControl x:Class="JunhyunHelper.Desktop.Items.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemRowTemplate">
            <Border x:Name="RowBorder" MinHeight="68" Padding="10,7"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" /><ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="74" /><ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" /><ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="?" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="7" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="필요" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="인레이드" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RequiredFir}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="필요" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="일반" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RequiredGeneral}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="보유" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="인레이드" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding OwnedFir}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock Text="보유" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Text="일반" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding OwnedNonFir}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundLightBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SourceRowTemplate">
            <Button IsEnabled="{Binding IsNavigable}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="10,8" Margin="0,0,0,7" Click="SourceButton_Click">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FlexibleRowTemplate">
            <Button Tag="{Binding QuestId}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="10,8" Margin="0,0,0,7" Click="FlexibleQuestButton_Click">
                <StackPanel>
                    <TextBlock Text="{Binding QuestName}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding CandidatesText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FlexibleCandidateTemplate">
            <Button Tag="{Binding ItemId}" Click="FlexibleCandidateButton_Click"
                    Height="68" MinHeight="68" MaxHeight="68"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center" Padding="10,6" Margin="4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44"
                            Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="?" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="7"
                                Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="인레이드" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OwnedFir}" FontWeight="SemiBold" FontSize="15"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="일반" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OwnedNonFir}" FontWeight="SemiBold" FontSize="15"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FlexibleGroupTemplate">
            <Border Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">
                    <Button Tag="{Binding QuestId}" Click="FlexibleQuestButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="9,7" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding QuestName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="퀘스트 보기" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,0,2,8" />
                    <ItemsControl ItemsSource="{Binding Candidates}" ItemTemplate="{StaticResource FlexibleCandidateTemplate}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,8,0" ToolTip="아이템 검색" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="CategoryComboBox" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="CategoryComboBox_SelectionChanged" />
            <ComboBox x:Name="UsageComboBox" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="UsageComboBox_SelectionChanged" />
            <ComboBox x:Name="FilterComboBox" Grid.Column="3" Margin="0,0,8,0" SelectionChanged="FilterComboBox_SelectionChanged" />
            <Button x:Name="ViewModeButton" Grid.Column="4" Content="유동 제출 보기" Click="ViewModeButton_Click" />
        </Grid>

        <Border x:Name="CleanupNotice" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CleanupNoticeText" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="정리 필요 보기" Margin="12,0,0,0" Click="ShowCleanupButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="590" /><ColumnDefinition Width="8" /><ColumnDefinition Width="430" MinWidth="340" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="ItemList" ItemTemplate="{StaticResource ItemRowTemplate}" SelectionChanged="ItemList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    <ScrollViewer x:Name="FlexibleGroupScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="10">
                        <ItemsControl x:Name="FlexibleGroupItems" ItemTemplate="{StaticResource FlexibleGroupTemplate}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyListText" Visibility="Collapsed" Text="조건에 맞는 아이템이 없습니다."
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />
            <Border Grid.Column="2" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText" Text="아이템을 선택하면 필요량과 보유량을 확인할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid><TextBlock Text="?" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="DetailIcon" Stretch="Uniform" Margin="4" /></Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailName" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailCategoryText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="필요 수량" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="인레이드 필요" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /><TextBlock x:Name="DetailRequiredFirText" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="일반 필요" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /><TextBlock x:Name="DetailRequiredGeneralText" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DetailCleanupText" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="보유 수량" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel x:Name="InventoryControls">
                                <TextBlock Text="인레이드" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="−" Click="OwnedFirMinusButton_Click" /><TextBox x:Name="OwnedFirTextBox" Grid.Column="1" Margin="6,0" TextAlignment="Center" /><Button Grid.Column="2" Content="+" Click="OwnedFirPlusButton_Click" /></Grid>
                                <TextBlock Text="일반" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="−" Click="OwnedNonFirMinusButton_Click" /><TextBox x:Name="OwnedNonFirTextBox" Grid.Column="1" Margin="6,0" TextAlignment="Center" /><Button Grid.Column="2" Content="+" Click="OwnedNonFirPlusButton_Click" /></Grid>
                            </StackPanel>
                            <Button x:Name="SaveInventoryButton" Content="직접 입력 저장" HorizontalAlignment="Left" Margin="0,0,0,18" Click="SaveInventoryButton_Click" />
                            <TextBlock Text="필요 출처" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl x:Name="SourceItems" ItemTemplate="{StaticResource SourceRowTemplate}" />
                            <StackPanel x:Name="FlexibleDetailPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock Text="유동 제출" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="후보 아이템은 퀘스트별 그룹 합계로 제출합니다. 퀘스트를 누르면 해당 퀘스트로 이동합니다."
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <ItemsControl x:Name="FlexibleRequirementItems" ItemTemplate="{StaticResource FlexibleRowTemplate}" />
                            </StackPanel>
                            <TextBlock x:Name="ProtectionText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

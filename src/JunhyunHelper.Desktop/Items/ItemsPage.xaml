<UserControl x:Class="JunhyunHelper.Desktop.Items.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemRowTemplate">
            <Border x:Name="RowBorder"
                    MinHeight="64"
                    Padding="10,7"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="108" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="?"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}"
                                   Stretch="Uniform"
                                   Margin="3" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="8,0,12,0">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="FirBadge"
                                    Background="{StaticResource BackgroundLightBrush}"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding FirBadgeVisibility}">
                                <TextBlock Text="{Binding FirBadgeText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding SourceSummary}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="필요"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RequiredTotal}"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="보유"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding OwnedTotal}"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Grid.Column="4"
                            Background="{StaticResource BackgroundDarkBrush}"
                            CornerRadius="9"
                            Padding="8,5"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{Binding StatusBrush}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundLightBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     ToolTip="아이템 검색"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="FilterComboBox"
                      Grid.Column="1"
                      SelectionChanged="FilterComboBox_SelectionChanged" />
        </Grid>

        <Border x:Name="CleanupNotice"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CleanupNoticeText"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="정리 필요 보기"
                        Margin="12,0,0,0"
                        Click="ShowCleanupButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="430" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundMediumBrush}"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ListBox x:Name="ItemList"
                         ItemTemplate="{StaticResource ItemRowTemplate}"
                         SelectionChanged="ItemList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundMediumBrush}"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="아이템을 선택하면 필요량과 보유량을 확인할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />

                    <ScrollViewer x:Name="DetailScroll"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64"
                                        Height="64"
                                        Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <TextBlock Text="?"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="DetailIcon"
                                               Stretch="Uniform"
                                               Margin="4" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailName"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailStatusText"
                                               Margin="0,4,0,0"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="DetailRequirementText" />
                                    <TextBlock x:Name="DetailRemainingText"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,5,0,0" />
                                    <TextBlock x:Name="DetailCleanupText"
                                               Foreground="{StaticResource WarningBrush}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="보유 수량"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FIR" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="OwnedFirTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="일반" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="OwnedNonFirTextBox" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="SaveInventoryButton"
                                    Content="보유량 저장"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,18"
                                    Click="SaveInventoryButton_Click" />

                            <TextBlock Text="필요 출처"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <ItemsControl x:Name="SourceItems" />

                            <StackPanel x:Name="FlexibleDetailPanel"
                                        Visibility="Collapsed"
                                        Margin="0,16,0,0">
                                <TextBlock Text="유동 제출"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="이 아이템은 다른 후보와 합쳐 제출할 수 있어 후보 하나만 따로 버려도 된다고 판단하지 않습니다."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />
                                <ItemsControl x:Name="FlexibleRequirementItems" />
                            </StackPanel>

                            <TextBlock x:Name="ProtectionText"
                                       Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="JunhyunHelper.Desktop.FarmingGuide.FarmingGuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewMouseMove="Root_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Grid x:Name="RootGrid" Background="{StaticResource BackgroundDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" MinWidth="450" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="장비" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PresetComboBox"
                                  Grid.Column="0"
                                  MinHeight="34"
                                  SelectionChanged="PresetComboBox_SelectionChanged" />
                        <Button Grid.Column="1"
                                Width="38"
                                Height="34"
                                Margin="7,0,0,0"
                                Content="💾"
                                ToolTip="현재 상태를 새 프리셋으로 저장"
                                Click="SavePresetButton_Click" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EquipmentPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="수납 공간" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="아이템을 끌어 놓으세요. 드래그 중 R로 회전할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StoragePanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Row="0"
                     Height="36"
                     Padding="10,6"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="한글/영문 이름으로 아이템 검색" />

            <Border Grid.Row="1"
                    Margin="0,10,0,12"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Background="{StaticResource BackgroundMediumBrush}">
                <ListBox x:Name="SearchResultsList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8"
                                    Margin="2"
                                    CornerRadius="5"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="SearchResult_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Image Source="{Binding Image}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EnglishName}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="2"
                    Padding="14"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Background="{StaticResource BackgroundMediumBrush}">
                <StackPanel>
                    <TextBlock Text="현재 상태" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="파밍한 가치" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                        <TextBlock x:Name="ValueSummaryText" Grid.Row="0" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="총 무게" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                        <TextBlock x:Name="WeightSummaryText" Grid.Row="1" Grid.Column="1" Text="0.00 kg" FontWeight="SemiBold" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="수납 공간" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
                        <TextBlock x:Name="StorageSummaryText" Grid.Row="2" Grid.Column="1" Text="0 / 0" FontWeight="SemiBold" Margin="0,2" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="DragOverlay"
                Grid.ColumnSpan="3"
                Panel.ZIndex="100"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>

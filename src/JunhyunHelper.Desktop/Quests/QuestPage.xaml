<UserControl x:Class="JunhyunHelper.Desktop.Quests.QuestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="QuestPage_Loaded"
             IsVisibleChanged="QuestPage_SpecialTraderAccessVisibilityChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="QuestRowTemplate">
            <Border x:Name="RowBorder"
                    MinHeight="58"
                    Padding="14,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" MinWidth="72" Background="{Binding StatusBrush}"
                            CornerRadius="9" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundLightBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="QuestItemLinkTemplate">
            <Button Tag="{Binding ItemId}"
                    Click="RequiredItemButton_Click"
                    HorizontalContentAlignment="Stretch"
                    Padding="8"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40"
                            Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="?" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PrerequisiteLinkTemplate">
            <Button Tag="{Binding QuestId}"
                    Click="PrerequisiteButton_Click"
                    HorizontalContentAlignment="Stretch"
                    Padding="10,8"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding AcceptedStatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,8,0" ToolTip="퀘스트 검색" TextChanged="FilterChanged" />
                <ComboBox x:Name="StatusFilter" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="FilterChanged" />
                <ComboBox x:Name="TraderFilter" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="FilterChanged" />
                <ComboBox x:Name="MapFilter" Grid.Column="3" Margin="0,0,8,0" SelectionChanged="FilterChanged" />
                <Button x:Name="ProblemsButton" Grid.Column="4" Content="판정 문제 0" Visibility="Collapsed" Click="ProblemsButton_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="440" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" ClipToBounds="True">
                <ListBox x:Name="QuestList"
                         ItemTemplate="{StaticResource QuestRowTemplate}"
                         SelectionChanged="QuestList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="퀘스트를 선택하면 상세 정보를 확인할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="DetailMeta" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                            <WrapPanel Margin="0,0,0,18">
                                <Button x:Name="WikiButton" Content="위키" Margin="0,0,8,8" Click="WikiButton_Click" />
                                <Button x:Name="PrimaryActionButton" Margin="0,0,8,8" Click="PrimaryActionButton_Click" />
                                <Button x:Name="FailureActionButton" Visibility="Collapsed" Margin="0,0,8,8" Click="FailureActionButton_Click" />
                                <Button x:Name="SpecialTraderAccessButton" Visibility="Collapsed" Margin="0,0,8,8" Click="SpecialTraderAccessButton_Click" />
                            </WrapPanel>

                            <TextBlock Text="목표" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,14">
                                <ItemsControl x:Name="ObjectivesList" />
                            </Border>

                            <TextBlock x:Name="RequiredItemsHeader" Text="제출 아이템" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border x:Name="RequiredItemsBox" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="7" Padding="8" Margin="0,0,0,14">
                                <ItemsControl x:Name="RequiredItemsList" ItemTemplate="{StaticResource QuestItemLinkTemplate}" />
                            </Border>

                            <TextBlock Text="해금 조건" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,14">
                                <ItemsControl x:Name="RequirementsList" />
                            </Border>

                            <TextBlock x:Name="PrerequisitesHeader" Text="선행 퀘스트" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border x:Name="PrerequisitesBox" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="7" Padding="8" Margin="0,0,0,14">
                                <ItemsControl x:Name="PrerequisitesList" ItemTemplate="{StaticResource PrerequisiteLinkTemplate}" />
                            </Border>

                            <TextBlock x:Name="StateReasonsHeader" Text="자동 판정 참고" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border x:Name="StateReasonsBox" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,14">
                                <ItemsControl x:Name="StateReasonsList" />
                            </Border>

                            <TextBlock x:Name="ExperienceText" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="JunhyunHelper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JunhyunHelper.Desktop"
        xmlns:quests="clr-namespace:JunhyunHelper.Desktop.Quests"
        xmlns:hideout="clr-namespace:JunhyunHelper.Desktop.Hideout"
        xmlns:items="clr-namespace:JunhyunHelper.Desktop.Items"
        xmlns:ammo="clr-namespace:JunhyunHelper.Desktop.Ammo"
        xmlns:scanner="clr-namespace:JunhyunHelper.Desktop.Scanner"
        Title="준현 헬퍼"
        Icon="Assets/AppIcon.png"
        Width="1320"
        Height="820"
        MinWidth="1180"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="Assets/AppIcon.png"
                           Width="28" Height="28"
                           Stretch="UniformToFill"
                           VerticalAlignment="Center"
                           Margin="0,0,9,0"
                           Cursor="Hand"
                           ToolTip="김태영 PC 진단"
                           MouseLeftButtonUp="AppIcon_MouseLeftButtonUp" />
                    <TextBlock Text="준현 헬퍼" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="QuestTabButton" Grid.Column="1" Content="퀘스트" Margin="0,0,6,0" Padding="14,7" Click="QuestTabButton_Click" />
                <Button x:Name="HideoutTabButton" Grid.Column="2" Content="은신처" Margin="0,0,6,0" Padding="14,7" Click="HideoutTabButton_Click" />
                <Grid Grid.Column="3" Margin="0,0,6,0">
                    <Button x:Name="ItemsTabButton"
                            Content="아이템"
                            Padding="14,7"
                            Click="ItemsTabButton_Click" />
                    <Ellipse x:Name="ItemsCleanupIndicator"
                             Width="8"
                             Height="8"
                             Fill="#F59E0B"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,4,0"
                             Visibility="Collapsed"
                             IsHitTestVisible="False"
                             Panel.ZIndex="10"
                             SnapsToDevicePixels="True" />
                </Grid>
                <Button x:Name="AmmoTabButton" Grid.Column="4" Content="탄약" Margin="0,0,6,0" Padding="14,7" Click="AmmoTabButton_Click" />
                <Button x:Name="MapTabButton" Grid.Column="5" Content="지도" Margin="0,0,6,0" Padding="14,7" Click="MapTabButton_Click" />
                <Button x:Name="ScannerTabButton" Grid.Column="6" Content="스캐너" Margin="0,0,6,0" Padding="14,7" Click="ScannerTabButton_Click" />

                <TextBlock x:Name="VersionText"
                           Grid.Column="7"
                           Margin="18,0"
                           Text="{x:Static local:ProductVersion.Label}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ProfileComboBox" Grid.Column="8" Width="195" Margin="0,0,8,0"
                          DropDownOpened="ProfileComboBox_DropDownOpened"
                          SelectionChanged="ProfileComboBox_CompactSelectionChanged" />
                <Button x:Name="EditProfileButton" Grid.Column="9" Content="프로필 수정" Margin="0,0,8,0"
                        Click="EditProfileCompactButton_Click" />
                <Button x:Name="UpdateDataButton" Grid.Column="10" Content="데이터 업데이트" Click="UnifiedUpdateDataButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <quests:QuestPage x:Name="QuestPage"
                              SpecialTraderAccessRequested="QuestPage_SpecialTraderAccessRequested"
                              Visibility="Collapsed" />
            <hideout:HideoutPage x:Name="HideoutPage" Visibility="Collapsed" />
            <items:ItemsPage x:Name="ItemsPage" Visibility="Collapsed" />
            <ammo:AmmoPage x:Name="AmmoPage" Visibility="Collapsed" />

            <Grid x:Name="MapPlaceholder" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="지도" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Border Background="{StaticResource BackgroundMediumBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,10"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <TextBlock Text="불러오는 중" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="지도 시스템을 준비하고 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <scanner:ScannerPage x:Name="ScannerPlaceholder" Visibility="Collapsed" />

            <Grid x:Name="EmptyState">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="EmptyStateTitle" Text="게임 진행 프로필이 없습니다."
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="프로필을 만들면 퀘스트·은신처 진행, 미래 필요 아이템과 탄약 정보를 사용할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,16" />
                    <Button x:Name="CreateProfileButton"
                            Content="프로필 만들기"
                            HorizontalAlignment="Center"
                            Click="CreateProfileOverlayButton_Click" />
                </StackPanel>
            </Grid>


            <Grid x:Name="KimTaeyoungDiagnosticProgressOverlay"
                  Visibility="Collapsed"
                  Background="#78000000"
                  Panel.ZIndex="110">
                <Border Width="420"
                        Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ProgressBar Height="10"
                                 IsIndeterminate="True"
                                 Background="{StaticResource BackgroundDarkBrush}"
                                 Foreground="{StaticResource AccentBrush}" />
                </Border>
            </Grid>

            <Grid x:Name="UpdateProgressOverlay"
                  Visibility="Collapsed"
                  Background="#78000000"
                  Panel.ZIndex="100">
                <Border Width="470"
                        Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="게임 데이터 업데이트"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="UpdateProgressStageText"
                                   Text="업데이트 준비 중..."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <ProgressBar x:Name="UpdateProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="10"
                                     Background="{StaticResource BackgroundDarkBrush}"
                                     Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="UpdateProgressPercentText"
                                   Text="0%"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

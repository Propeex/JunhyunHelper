<Window x:Class="JunhyunHelper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:quests="clr-namespace:JunhyunHelper.Desktop.Quests"
        Title="준현 헬퍼"
        Width="1320"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="준현 헬퍼"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0" />

                <Button Grid.Column="1"
                        Content="퀘스트"
                        IsEnabled="False"
                        Padding="16,7" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="18,0" />

                <ComboBox x:Name="ProfileComboBox"
                          Grid.Column="3"
                          Width="220"
                          Margin="0,0,8,0"
                          SelectionChanged="ProfileComboBox_SelectionChanged" />

                <Button x:Name="UpdateDataButton"
                        Grid.Column="4"
                        Content="데이터 업데이트"
                        Click="UpdateDataButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <quests:QuestPage x:Name="QuestPage"
                              Visibility="Collapsed" />

            <Grid x:Name="EmptyState">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520">
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="게임 진행 프로필이 없습니다."
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="프로필을 설정하면 현재 퀘스트와 잠김·완료 퀘스트를 확인할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

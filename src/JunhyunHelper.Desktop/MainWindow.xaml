<Window x:Class="JunhyunHelper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:quests="clr-namespace:JunhyunHelper.Desktop.Quests"
        xmlns:hideout="clr-namespace:JunhyunHelper.Desktop.Hideout"
        xmlns:items="clr-namespace:JunhyunHelper.Desktop.Items"
        Title="준현 헬퍼"
        Width="1320"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="준현 헬퍼"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0" />

                <Button x:Name="QuestTabButton"
                        Grid.Column="1"
                        Content="퀘스트"
                        Margin="0,0,6,0"
                        Padding="16,7"
                        Click="QuestTabButton_Click" />

                <Button x:Name="HideoutTabButton"
                        Grid.Column="2"
                        Content="은신처"
                        Margin="0,0,6,0"
                        Padding="16,7"
                        Click="HideoutTabButton_Click" />

                <Button x:Name="ItemsTabButton"
                        Grid.Column="3"
                        Content="아이템"
                        Padding="16,7"
                        Click="ItemsTabButton_Click" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="4"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="18,0" />

                <ComboBox x:Name="ProfileComboBox"
                          Grid.Column="5"
                          Width="180"
                          Margin="0,0,8,0"
                          SelectionChanged="ProfileComboBox_SelectionChanged" />

                <Button x:Name="EditProfileButton"
                        Grid.Column="6"
                        Content="프로필 수정"
                        Margin="0,0,8,0"
                        Click="EditProfileButton_Click" />

                <Button x:Name="CreateProfileButton"
                        Grid.Column="7"
                        Content="새 프로필"
                        Margin="0,0,8,0"
                        Click="CreateProfileButton_Click" />

                <Button x:Name="UpdateDataButton"
                        Grid.Column="8"
                        Content="데이터 업데이트"
                        Click="UpdateDataButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <quests:QuestPage x:Name="QuestPage"
                              Visibility="Collapsed" />
            <hideout:HideoutPage x:Name="HideoutPage"
                                 Visibility="Collapsed" />
            <items:ItemsPage x:Name="ItemsPage"
                             Visibility="Collapsed" />

            <Grid x:Name="EmptyState">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520">
                    <TextBlock x:Name="EmptyStateTitle"
                               Text="게임 진행 프로필이 없습니다."
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="프로필을 만들면 퀘스트·은신처 진행과 미래 필요 아이템을 관리할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,16" />
                    <Button Content="프로필 만들기"
                            HorizontalAlignment="Center"
                            Click="CreateProfileButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

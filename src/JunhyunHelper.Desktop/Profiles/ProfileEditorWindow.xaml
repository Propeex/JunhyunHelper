<Window x:Class="JunhyunHelper.Desktop.Profiles.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로필 설정"
        Width="720"
        Height="720"
        MinWidth="620"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText"
                       Text="프로필 설정"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ModeText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="레벨"
                       VerticalAlignment="Center"
                       Margin="0,0,10,10" />
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="−" Click="LevelMinusButton_Click" />
                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundDarkBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Margin="6,0"
                        CornerRadius="6">
                    <TextBlock x:Name="LevelValueText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="2" Content="+" Click="LevelPlusButton_Click" />
            </Grid>

            <TextBlock Grid.Row="0" Grid.Column="3"
                       Text="진영"
                       VerticalAlignment="Center"
                       Margin="0,0,10,10" />
            <ComboBox x:Name="FactionComboBox"
                      Grid.Row="0" Grid.Column="4"
                      Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="에디션"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="EditionComboBox"
                      Grid.Row="1" Grid.Column="1" />

            <TextBlock Grid.Row="1" Grid.Column="3"
                       Text="프레스티지"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <Grid Grid.Row="1" Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="−" Click="PrestigeMinusButton_Click" />
                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundDarkBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Margin="6,0"
                        CornerRadius="6">
                    <TextBlock x:Name="PrestigeValueText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="2" Content="+" Click="PrestigePlusButton_Click" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="상인 진행 상태"
                           FontWeight="SemiBold"
                           FontSize="16" />
                <TextBlock Text="일반 상인은 LL만 기록합니다. Fence는 Scav 우호도를 0.1 단위로 기록합니다."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,4,0,10" />

                <ItemsControl x:Name="TraderItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BackgroundMediumBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Grid Grid.Column="1"
                                          Visibility="{Binding LoyaltyVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="−"
                                                Click="TraderLoyaltyMinusButton_Click" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LoyaltyDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Content="+"
                                                Click="TraderLoyaltyPlusButton_Click" />
                                    </Grid>
                                    <Grid Grid.Column="1"
                                          Visibility="{Binding FenceStandingVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="−"
                                                Click="TraderStandingMinusButton_Click" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StandingDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Content="+"
                                                Click="TraderStandingPlusButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="AdvancedStandingExpander"
                          Header="고급 · 퀘스트 판정용 일반 상인 우호도"
                          Margin="0,8,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="일부 특수 퀘스트는 LL과 별도로 상인 우호도를 요구합니다. 모르는 값은 입력하지 않아도 되며, 그 퀘스트만 판정 문제로 남습니다."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,8" />
                        <ItemsControl x:Name="AdvancedStandingItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundMediumBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,7"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1"
                                                      Content="입력"
                                                      IsChecked="{Binding IsStandingKnown, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="−"
                                                    IsEnabled="{Binding IsStandingKnown}"
                                                    Click="TraderStandingMinusButton_Click" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding StandingDisplay}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="4"
                                                    Content="+"
                                                    IsEnabled="{Binding IsStandingKnown}"
                                                    Click="TraderStandingPlusButton_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="DeleteProfileButton"
                    Content="이 프로필 삭제"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="DeleteProfileButton_Click" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="취소"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="저장"
                        IsDefault="True"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

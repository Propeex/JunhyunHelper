<Window x:Class="JunhyunHelper.Desktop.Profiles.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로필 설정"
        Width="720"
        Height="680"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText"
                       Text="프로필 설정"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ModeText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="레벨"
                       VerticalAlignment="Center"
                       Margin="0,0,10,10" />
            <TextBox x:Name="LevelTextBox"
                     Grid.Row="0" Grid.Column="1"
                     Margin="0,0,0,10" />

            <TextBlock Grid.Row="0" Grid.Column="3"
                       Text="진영"
                       VerticalAlignment="Center"
                       Margin="0,0,10,10" />
            <ComboBox x:Name="FactionComboBox"
                      Grid.Row="0" Grid.Column="4"
                      Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="에디션"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="EditionComboBox"
                      Grid.Row="1" Grid.Column="1" />

            <TextBlock Grid.Row="1" Grid.Column="3"
                       Text="프레스티지"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBox x:Name="PrestigeTextBox"
                     Grid.Row="1" Grid.Column="4" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="상인 진행 상태"
                           FontWeight="SemiBold"
                           FontSize="16" />
                <TextBlock Text="알고 있는 상인만 '입력'을 체크해 LL과 평판을 적으세요. 미입력 값은 프로그램이 0으로 추측하지 않습니다."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>

            <DataGrid x:Name="TraderGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      Background="{StaticResource BackgroundMediumBrush}"
                      RowBackground="{StaticResource BackgroundMediumBrush}"
                      AlternatingRowBackground="{StaticResource BackgroundLightBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="입력"
                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                            Width="70" />
                    <DataGridTextColumn Header="상인"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="LL"
                                        Binding="{Binding LoyaltyText, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90" />
                    <DataGridTextColumn Header="평판"
                                        Binding="{Binding StandingText, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="취소"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="저장"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

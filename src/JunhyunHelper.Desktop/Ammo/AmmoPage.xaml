<UserControl x:Class="JunhyunHelper.Desktop.Ammo.AmmoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource BackgroundMediumBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundDarkBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ArmorEffectivenessCellTemplate">
            <Border Background="{Binding Background}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Width="31"
                    MinHeight="31"
                    Margin="2,0"
                    ToolTip="{Binding ToolTip}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ArmorClass}"
                               Foreground="{Binding Foreground}"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Opacity="0.8" />
                    <TextBlock Text="{Binding DisplayValue}"
                               Foreground="{Binding Foreground}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="2*" MinHeight="190" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="구경" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
            <ComboBox x:Name="CaliberComboBox" Grid.Column="1" SelectionChanged="CaliberComboBox_SelectionChanged" />
            <Button x:Name="ColumnMenuButton" Grid.Column="3" Content="표시 열" Padding="14,6" Click="ColumnMenuButton_Click" />

            <Popup x:Name="ColumnMenuPopup"
                   PlacementTarget="{Binding ElementName=ColumnMenuButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,6,0,0">
                    <StackPanel MinWidth="190">
                        <TextBlock Text="표에 표시할 정보" FontWeight="SemiBold" Margin="2,0,0,8" />
                        <CheckBox x:Name="CaliberColumnCheckBox" Content="구경" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="DamageColumnCheckBox" Content="피해" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="PenetrationColumnCheckBox" Content="관통" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="ArmorDamageColumnCheckBox" Content="장갑 피해" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="ArmorEffectivenessColumnCheckBox" Content="방탄 등급별 효율" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="SpeedColumnCheckBox" Content="속도" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="FragmentationColumnCheckBox" Content="파편" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="RecoilColumnCheckBox" Content="반동" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="AccuracyColumnCheckBox" Content="명중" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                        <CheckBox x:Name="AcquisitionColumnCheckBox" Content="수급 경로" IsChecked="True" Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <TextBlock x:Name="SummaryText" Grid.Row="1"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10" />

        <DataGrid x:Name="AmmoGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2"
                  SelectionChanged="AmmoGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="탄약" Width="2*" MinWidth="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36"
                                        Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="5" Margin="0,0,8,0">
                                    <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2" />
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="CaliberColumn" Header="구경" Binding="{Binding CaliberLabel}" Width="140" />
                <DataGridTextColumn x:Name="DamageColumn" Header="피해" Binding="{Binding DamageText}" Width="85" />
                <DataGridTextColumn x:Name="PenetrationColumn" Header="관통" Binding="{Binding PenetrationPower}" Width="70" />
                <DataGridTextColumn x:Name="ArmorDamageColumn" Header="장갑 피해" Binding="{Binding ArmorDamageText}" Width="90" />
                <DataGridTemplateColumn x:Name="ArmorEffectivenessColumn" Header="방탄 효율 1–6" Width="225" MinWidth="210">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding ArmorEffectivenessCells}"
                                          ItemTemplate="{StaticResource ArmorEffectivenessCellTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="SpeedColumn" Header="속도" Binding="{Binding SpeedText}" Width="95" />
                <DataGridTextColumn x:Name="FragmentationColumn" Header="파편" Binding="{Binding FragmentationText}" Width="75" />
                <DataGridTextColumn x:Name="RecoilColumn" Header="반동" Binding="{Binding RecoilText}" Width="75" />
                <DataGridTextColumn x:Name="AccuracyColumn" Header="명중" Binding="{Binding AccuracyText}" Width="75" />
                <DataGridTextColumn x:Name="AcquisitionColumn" Header="수급 경로" Binding="{Binding AcquisitionText}" Width="220" MinWidth="150" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="8" Background="Transparent" HorizontalAlignment="Stretch" />

        <Border Grid.Row="4" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <TextBlock x:Name="EmptyDetailText"
                           Text="탄약을 선택하면 세부 성능과 수급처를 확인할 수 있습니다."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Grid x:Name="DetailGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="340" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="62" Height="62"
                                        Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="7">
                                    <Image x:Name="DetailIcon" Stretch="Uniform" Margin="3" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailName" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailIdentity" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailPerformance" />

                            <TextBlock Text="방탄 등급별 효율"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,14,0,7" />
                            <ItemsControl x:Name="DetailArmorEffectivenessItems"
                                          ItemTemplate="{StaticResource ArmorEffectivenessCellTemplate}"
                                          HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="0–6은 Tarkov Wiki Ballistics의 비교 효율값입니다. '?'는 현재 Wiki 행과 안전하게 매칭되지 않은 탄약입니다."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />

                            <TextBlock x:Name="DetailModifiers" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="수급처" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl x:Name="AcquisitionItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Conditions}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Details}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Unlock}" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerHotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 단축키 설정"
        Width="440"
        Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="14"
            Background="{StaticResource BackgroundMediumBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ActionText"
                       Text="사용할 단축키를 누르세요"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="Ctrl / Alt / Shift 중 하나 이상과 일반 키를 함께 사용합니다. Esc는 취소입니다."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="GestureText"
                       Grid.Row="2"
                       Text="입력 대기 중..."
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="사용 안 함" MinWidth="92" Margin="0,0,8,0" Click="DisableButton_Click" />
                <Button Content="취소" MinWidth="76" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

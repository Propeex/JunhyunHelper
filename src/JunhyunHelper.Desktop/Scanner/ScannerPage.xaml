<UserControl x:Class="JunhyunHelper.Desktop.Scanner.ScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="ScannerPage_Loaded"
             IsVisibleChanged="ScannerPage_IsVisibleChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="ScannerActivityTemplate">
            <Border Padding="12,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModeLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ResultLabel}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <TextBlock Text="{Binding DetailText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Everyday Scanner controls. Keep the primary path usable without exposing
             detector/catalog/regression terminology. -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ScannerToggleButton"
                        Grid.Column="0"
                        Content="스캐너 OFF"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="ScannerToggleButton_Click" />
                <Button x:Name="OneShotScanButton"
                        Grid.Column="1"
                        Content="1회 스캔"
                        MinWidth="104"
                        Margin="0,0,8,0"
                        Click="OneShotScanButton_Click" />
                <Button x:Name="CorrectionButton"
                        Grid.Column="2"
                        Content="현재 결과 교정"
                        MinWidth="118"
                        Padding="10,5"
                        Click="CorrectionButton_Click" />
                <TextBlock x:Name="RuntimeStatusText"
                           Grid.Column="3"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="16,0,2,0" />
            </Grid>
        </Border>

        <!-- User settings stay available, but do not occupy the main Scanner surface. -->
        <Expander Grid.Row="1"
                  Header="설정"
                  Background="{StaticResource BackgroundMediumBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Margin="0,0,0,10">
            <StackPanel Margin="12,8,12,12">
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="HotkeySettingsButton"
                            Content="단축키 설정"
                            MinWidth="112"
                            Padding="10,5"
                            Margin="0,0,8,0"
                            Click="HotkeySettingsButton_Click" />
                    <Button x:Name="OcrSubstitutionSettingsButton"
                            Content="OCR 문자 치환"
                            MinWidth="118"
                            Padding="10,5"
                            Click="OcrSubstitutionSettingsButton_Click" />
                </WrapPanel>

                <TextBlock Text="Mini Scanner 표시 정보"
                           FontWeight="SemiBold"
                           Margin="0,2,0,9" />
                <WrapPanel>
                    <CheckBox x:Name="ShowItemNameCheckBox" Content="아이템 이름" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowItemIconCheckBox" Content="아이템 아이콘" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowTraderSellPriceCheckBox" Content="최고 상점가" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowFleaAveragePriceCheckBox" Content="플리마켓 평균가" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowTraderPricePerSlotCheckBox" Content="상점가 / 칸" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowFleaPricePerSlotCheckBox" Content="플리 평균가 / 칸" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowCurrentNeededCheckBox" Content="현재 필요한 수량" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                </WrapPanel>
            </StackPanel>
        </Expander>

        <!-- Developer/recovery features remain intact behind one advanced surface. -->
        <Expander Grid.Row="2"
                  Header="고급 / 진단"
                  Background="{StaticResource BackgroundMediumBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  Margin="0,0,0,10">
            <StackPanel Margin="12,8,12,12">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="일반 플레이에는 필요하지 않습니다. 테스트·복구·Ground Truth·개발 진단 기능을 제공합니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DiagnosticsStorageText"
                               Grid.Column="1"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <WrapPanel>
                    <Button x:Name="TestToggleButton"
                            Content="테스트 OFF"
                            MinWidth="104"
                            Margin="0,0,8,8"
                            Click="TestToggleButton_Click" />
                    <Button x:Name="RecognitionImageButton"
                            Content="인식 이미지"
                            MinWidth="96"
                            Padding="10,4"
                            Margin="0,0,8,8"
                            Click="RecognitionImageButton_Click" />
                    <Button x:Name="RegressionButton"
                            Content="회귀 테스트"
                            MinWidth="96"
                            Padding="10,4"
                            Margin="0,0,8,8"
                            Click="RegressionButton_Click" />
                    <Button x:Name="ExportDiagnosticsButton"
                            Content="교정 데이터 내보내기"
                            MinWidth="138"
                            Padding="10,4"
                            Margin="0,0,8,8"
                            Click="ExportDiagnosticsButton_Click" />
                    <Button x:Name="ManageDiagnosticsButton"
                            Content="교정 데이터 관리"
                            MinWidth="118"
                            Padding="10,4"
                            Margin="0,0,8,8"
                            Click="ManageDiagnosticsButton_Click" />
                    <Button x:Name="SyncCatalogButton"
                            Content="아이템 목록 최신화"
                            MinWidth="154"
                            Padding="10,4"
                            Margin="0,0,8,8"
                            Click="SyncCatalogButton_Click" />
                    <Button x:Name="ClearLogButton"
                            Content="로그 삭제"
                            MinWidth="84"
                            Padding="10,4"
                            Margin="0,0,0,8"
                            Click="ClearLogButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Expander>

        <Border Grid.Row="3"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10">
                    <TextBlock Text="최근 인식 기록"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ActivityItems"
                                      ItemTemplate="{StaticResource ScannerActivityTemplate}" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyActivityText"
                               Text="아직 인식 기록이 없습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
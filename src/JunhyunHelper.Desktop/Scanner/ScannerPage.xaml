<UserControl x:Class="JunhyunHelper.Desktop.Scanner.ScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="ScannerPage_Loaded"
             IsVisibleChanged="ScannerPage_IsVisibleChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="ScannerActivityTemplate">
            <Border Padding="12,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModeLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ResultLabel}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <TextBlock Text="{Binding DetailText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScannerSearchResultTemplate">
            <Grid Margin="5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}"
                       Width="36"
                       Height="36"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding OfficialName}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ScannerToggleButton"
                        Content="스캐너 OFF"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="ScannerToggleButton_Click" />
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Content="설정"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Click="SettingsButton_Click" />
                <Button x:Name="AdvancedButton"
                        Grid.Column="2"
                        Content="고급"
                        MinWidth="92"
                        Click="AdvancedButton_Click" />
                <TextBlock x:Name="RuntimeStatusText"
                           Grid.Column="3"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="16,0,2,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="430" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="9*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="아이템 검색"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ItemSearchBox"
                                 MinHeight="34"
                                 VerticalContentAlignment="Center"
                                 TextChanged="ItemSearchBox_TextChanged"
                                 PreviewKeyDown="ItemSearchBox_PreviewKeyDown" />
                        <Button Grid.Column="1"
                                Content="×"
                                Width="36"
                                Height="34"
                                Margin="6,0,0,0"
                                ToolTip="검색어 지우기"
                                Click="ClearSearchButton_Click" />
                        <Popup x:Name="SearchResultsPopup"
                               PlacementTarget="{Binding ElementName=ItemSearchBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border MinWidth="380"
                                    MaxWidth="560"
                                    Background="{StaticResource BackgroundMediumBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="5">
                                <ListBox x:Name="SearchResultList"
                                         MaxHeight="380"
                                         Background="{StaticResource BackgroundDarkBrush}"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource ScannerSearchResultTemplate}"
                                         PreviewMouseLeftButtonUp="SearchResultList_PreviewMouseLeftButtonUp" />
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="EmptyItemText"
                                   Text="아이템을 검색해 선택하세요."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <StackPanel x:Name="SelectedItemPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="SelectedItemIcon"
                                       Width="72"
                                       Height="72"
                                       Stretch="Uniform"
                                       VerticalAlignment="Top" />
                                <TextBlock x:Name="SelectedItemNameText"
                                           Grid.Column="1"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0" />
                                <Button x:Name="WikiButton"
                                        Grid.Column="2"
                                        Content="위키"
                                        MinWidth="72"
                                        VerticalAlignment="Center"
                                        Click="WikiButton_Click" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="플리마켓 평균가" Margin="0,0,12,12" />
                                <TextBlock x:Name="FleaAverageText" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Grid.Row="1" Text="최고 상인 판매가" Margin="0,0,12,12" />
                                <TextBlock x:Name="BestTraderText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Grid.Row="2" Text="필요 개수" Margin="0,0,12,0" />
                                <TextBlock x:Name="NeededCountText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="로그"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="12,10" />
                    <Grid Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ActivityItems"
                                          ItemTemplate="{StaticResource ScannerActivityTemplate}" />
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyActivityText"
                                   Text="아직 인식 기록이 없습니다."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

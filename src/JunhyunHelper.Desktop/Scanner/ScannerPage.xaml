<UserControl x:Class="JunhyunHelper.Desktop.Scanner.ScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="ScannerPage_Loaded"
             IsVisibleChanged="ScannerPage_IsVisibleChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="ScannerActivityTemplate">
            <Border Padding="12,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModeLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ResultLabel}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <TextBlock Text="{Binding DetailText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ScannerToggleButton"
                        Grid.Column="0"
                        Content="스캐너 OFF"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="ScannerToggleButton_Click" />
                <Button x:Name="TestToggleButton"
                        Grid.Column="1"
                        Content="테스트 OFF"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="TestToggleButton_Click" />
                <Button x:Name="HotkeySettingsButton"
                        Grid.Column="2"
                        Content="단축키 설정"
                        MinWidth="112"
                        Padding="10,5"
                        Click="HotkeySettingsButton_Click" />
                <Button x:Name="SyncCatalogButton"
                        Grid.Column="4"
                        Content="아이템 목록 최신화"
                        MinWidth="132"
                        Click="SyncCatalogButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="표시 정보"
                           FontWeight="SemiBold"
                           Margin="0,0,0,9" />
                <WrapPanel>
                    <CheckBox x:Name="ShowItemNameCheckBox" Content="아이템 이름" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowItemIconCheckBox" Content="아이템 아이콘" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowTraderSellPriceCheckBox" Content="상인 판매 가격" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowFleaAveragePriceCheckBox" Content="플리마켓 평균 가격" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowTraderPricePerSlotCheckBox" Content="상인 가격 / 슬롯" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowFleaPricePerSlotCheckBox" Content="플리 가격 / 슬롯" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                    <CheckBox x:Name="ShowCurrentNeededCheckBox" Content="현재 필요한 수량" Margin="0,0,22,8" Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="최근 인식 기록"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="RuntimeStatusText"
                               Grid.Column="1"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="16,0,12,0" />
                    <TextBlock x:Name="DiagnosticsStorageText"
                               Grid.Column="2"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button x:Name="RecognitionImageButton"
                            Grid.Column="3"
                            Content="인식 이미지"
                            MinWidth="92"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="RecognitionImageButton_Click" />
                    <Button x:Name="CorrectionButton"
                            Grid.Column="4"
                            Content="교정"
                            MinWidth="70"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="CorrectionButton_Click" />
                    <Button x:Name="RegressionButton"
                            Grid.Column="5"
                            Content="회귀 테스트"
                            MinWidth="92"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="RegressionButton_Click" />
                    <Button x:Name="ExportDiagnosticsButton"
                            Grid.Column="6"
                            Content="교정 데이터 내보내기"
                            MinWidth="138"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="ExportDiagnosticsButton_Click" />
                    <Button x:Name="ClearDiagnosticsButton"
                            Grid.Column="7"
                            Content="교정 데이터 삭제"
                            MinWidth="118"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="ClearDiagnosticsButton_Click" />
                    <Button x:Name="ClearLogButton"
                            Grid.Column="8"
                            Content="로그 삭제"
                            MinWidth="84"
                            Padding="10,4"
                            Click="ClearLogButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ActivityItems"
                                      ItemTemplate="{StaticResource ScannerActivityTemplate}" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyActivityText"
                               Text="아직 인식 기록이 없습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
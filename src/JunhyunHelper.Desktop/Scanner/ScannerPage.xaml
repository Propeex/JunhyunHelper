<UserControl x:Class="JunhyunHelper.Desktop.Scanner.ScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="ScannerPage_Loaded"
             Unloaded="ScannerPage_Unloaded"
             IsVisibleChanged="ScannerPage_IsVisibleChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="ScannerActivityTemplate">
            <Border Padding="12,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModeLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ResultLabel}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                        <Button Grid.Column="4"
                                Content="교정"
                                Tag="{Binding}"
                                IsEnabled="{Binding CanCorrect}"
                                MinWidth="54"
                                Padding="8,2"
                                Margin="8,-3,0,-3"
                                ToolTip="이 인식 결과의 저장된 진단 자료를 바로 교정합니다."
                                Click="CorrectActivityButton_Click" />
                    </Grid>
                    <TextBlock Text="{Binding Summary}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <TextBlock Text="{Binding DetailText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScannerSearchResultTemplate">
            <Grid Margin="5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}"
                       Width="36"
                       Height="36"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding OfficialName}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ScannerFavoriteItemTemplate">
            <Grid Margin="8,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Tag="{Binding ItemId}"
                        HorizontalContentAlignment="Stretch"
                        Padding="7,5"
                        Click="FavoriteItemBodyButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon}"
                               Width="32"
                               Height="32"
                               Stretch="Uniform"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Margin="7,0,4,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </Grid>
                </Button>
                <Button Grid.Column="1"
                        Tag="{Binding ItemId}"
                        Content="★"
                        Width="36"
                        MinHeight="34"
                        Margin="5,0,0,0"
                        ToolTip="즐겨찾기 해제"
                        Click="FavoriteItemRemoveButton_Click" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ScannerRecentItemTemplate">
            <Grid Margin="8,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Tag="{Binding ItemId}"
                        HorizontalContentAlignment="Stretch"
                        Padding="7,5"
                        Click="RecentItemBodyButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon}"
                               Width="32"
                               Height="32"
                               Stretch="Uniform"
                               VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Margin="7,0,4,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </Grid>
                </Button>
                <Button Grid.Column="1"
                        Tag="{Binding ItemId}"
                        Content="×"
                        Width="36"
                        MinHeight="34"
                        Margin="5,0,0,0"
                        ToolTip="최근 본 아이템에서 제거"
                        Click="RecentItemRemoveButton_Click" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ScannerToggleButton"
                        Content="스캐너 OFF"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="ScannerToggleButton_Click" />
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Content="설정"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Click="ProductSettingsButton_Click" />
                <Button x:Name="AdvancedButton"
                        Grid.Column="2"
                        Content="고급"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Click="ProductAdvancedButton_Click" />
                <Button x:Name="CurrentCorrectionButton"
                        Grid.Column="5"
                        Content="현재 결과 교정"
                        MinWidth="118"
                        Margin="8,0,0,0"
                        Click="CurrentCorrectionButton_Click" />
                <TextBlock x:Name="RuntimeStatusText"
                           Grid.Column="4"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="16,0,2,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="430" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="9*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="아이템 검색"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <TextBox x:Name="ItemSearchBox"
                                 MinHeight="34"
                                 VerticalContentAlignment="Center"
                                 TextChanged="ItemSearchBox_TextChanged"
                                 PreviewKeyDown="ItemSearchBox_PreviewKeyDown" />
                        <Popup x:Name="SearchResultsPopup"
                               PlacementTarget="{Binding ElementName=ItemSearchBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border MinWidth="380"
                                    MaxWidth="560"
                                    Background="{StaticResource BackgroundMediumBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="5">
                                <ListBox x:Name="SearchResultList"
                                         MaxHeight="380"
                                         Background="{StaticResource BackgroundDarkBrush}"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource ScannerSearchResultTemplate}"
                                         PreviewMouseLeftButtonUp="SearchResultList_PreviewMouseLeftButtonUp" />
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="EmptyItemText"
                                   Text="아이템을 검색해 선택하세요."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SelectedItemPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="SelectedItemIcon"
                                       Width="72"
                                       Height="72"
                                       Stretch="Uniform"
                                       VerticalAlignment="Top" />
                                <TextBlock x:Name="SelectedItemNameText"
                                           Grid.Column="1"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0" />
                                <Button x:Name="FavoriteItemButton"
                                        Grid.Column="2"
                                        Content="☆"
                                        Width="40"
                                        Height="34"
                                        MinHeight="34"
                                        Margin="0,0,6,0"
                                        Padding="0"
                                        FontFamily="Segoe UI Symbol"
                                        FontSize="18"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsEnabled="False"
                                        ToolTip="즐겨찾기 등록"
                                        VerticalAlignment="Center"
                                        Click="FavoriteItemButton_Click" />
                                <Button x:Name="WikiButton"
                                        Grid.Column="3"
                                        Content="위키"
                                        MinWidth="72"
                                        Height="34"
                                        MinHeight="34"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="WikiButton_Click" />
                            </Grid>

                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="즐겨찾기"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="12,10" />
                        <Grid Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                            <ScrollViewer x:Name="FavoriteItemsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FavoriteItems"
                                              ItemTemplate="{StaticResource ScannerFavoriteItemTemplate}" />
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyFavoriteItemsText"
                                       Text="즐겨찾기한 아이템이 없습니다."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="12,7,8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="최근 본 아이템"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ClearRecentItemsButton"
                                    Grid.Column="1"
                                    Content="전부 삭제"
                                    Padding="8,3"
                                    MinWidth="72"
                                    Click="ClearRecentItemsButton_Click" />
                        </Grid>
                        <Grid Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}">
                            <ScrollViewer x:Name="RecentItemsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="RecentItems"
                                              ItemTemplate="{StaticResource ScannerRecentItemTemplate}" />
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyRecentItemsText"
                                       Text="최근 본 아이템이 없습니다."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- The diagnostic activity feed remains alive for support/correction data but is
             intentionally not part of the v1.9.0 user-facing Scanner surface. -->
        <Grid Visibility="Collapsed" IsHitTestVisible="False">
            <ItemsControl x:Name="ActivityItems"
                          ItemTemplate="{StaticResource ScannerActivityTemplate}" />
            <TextBlock x:Name="EmptyActivityText" />
        </Grid>
    </Grid>
</UserControl>

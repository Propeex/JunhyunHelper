<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 설정"
        Width="600"
        Height="690"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="14">
        <Border Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Mini Scanner 표시 정보"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <ListBox x:Name="InfoOrderList"
                         Grid.Row="1"
                         Background="{StaticResource BackgroundDarkBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"
                                          Click="InfoVisibilityCheckBox_Click" />
                                <Button Grid.Column="1"
                                        Content="▲"
                                        Width="36"
                                        Height="28"
                                        Margin="8,0,4,0"
                                        ToolTip="위로 이동"
                                        Click="MoveUpButton_Click" />
                                <Button Grid.Column="2"
                                        Content="▼"
                                        Width="36"
                                        Height="28"
                                        ToolTip="아래로 이동"
                                        Click="MoveDownButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="Scanner 단축키"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,20,0,10" />

                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1회 인게임 스캔" VerticalAlignment="Center" />
                        <TextBlock x:Name="OneShotTarkovText" Grid.Column="1"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="변경" MinWidth="76"
                                Click="ChangeOneShotTarkovButton_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1회 테스트 스캔" VerticalAlignment="Center" />
                        <TextBlock x:Name="OneShotTestText" Grid.Column="1"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="변경" MinWidth="76"
                                Click="ChangeOneShotTestButton_Click" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="스캐너 ON/OFF" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScannerToggleText" Grid.Column="1"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="변경" MinWidth="76"
                                Click="ChangeScannerToggleButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
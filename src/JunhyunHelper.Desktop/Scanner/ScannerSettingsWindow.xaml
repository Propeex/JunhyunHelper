<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 설정"
        Width="620"
        Height="600"
        MinWidth="540"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="단축키" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="HotkeySummaryText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,12,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="단축키 설정"
                        MinWidth="112"
                        VerticalAlignment="Center"
                        Click="HotkeySettingsButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Mini Scanner 표시 정보"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Text="아이콘과 아이템 이름은 항상 표시됩니다. 아래 정보는 표시 여부와 순서를 변경할 수 있습니다."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,12" />

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <Border Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,6">
                        <TextBlock Text="아이콘  ·  항상 표시" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8">
                        <TextBlock Text="아이템 이름  ·  항상 표시" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <ListBox x:Name="InfoOrderList"
                         Grid.Row="3"
                         Background="{StaticResource BackgroundDarkBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="▲"
                                        Width="36"
                                        Height="28"
                                        Margin="8,0,4,0"
                                        ToolTip="위로 이동"
                                        Click="MoveUpButton_Click" />
                                <Button Grid.Column="2"
                                        Content="▼"
                                        Width="36"
                                        Height="28"
                                        ToolTip="아래로 이동"
                                        Click="MoveDownButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="취소" MinWidth="84" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="저장" MinWidth="92" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

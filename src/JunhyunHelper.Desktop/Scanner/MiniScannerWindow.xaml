<Window x:Class="JunhyunHelper.Desktop.Scanner.MiniScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <!-- Alpha 1 is visually transparent but remains a reliable hit-test surface on a
         layered WPF window. The whole rendered card, not only text/icon pixels, drags. -->
    <Border x:Name="DragSurface"
            Background="#01000000"
            Padding="6"
            Cursor="Arrow"
            ForceCursor="True"
            PreviewMouseLeftButtonDown="DragSurface_PreviewMouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="현재 결과 교정"
                          Click="CurrentCorrectionMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid x:Name="ItemContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="ItemIcon"
                   Width="48"
                   Height="48"
                   Stretch="Uniform"
                   Margin="0,0,9,0"
                   VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" MinWidth="110">
                <TextBlock x:Name="ItemNameText"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Margin="0,0,0,2" />
                <TextBlock x:Name="TraderPriceText" Foreground="White" />
                <TextBlock x:Name="FleaPriceText" Foreground="White" />
                <TextBlock x:Name="TraderSlotPriceText" Foreground="White" />
                <TextBlock x:Name="FleaSlotPriceText" Foreground="White" />
                <TextBlock x:Name="CurrentNeededText" Foreground="White" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
<Window x:Class="JunhyunHelper.Desktop.Scanner.MiniScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <!-- Alpha 1 is visually transparent but remains a reliable hit-test surface on a
         layered WPF window. The whole rendered card, not only text/icon pixels, drags. -->
    <Border x:Name="DragSurface"
            Background="#01000000"
            Padding="6"
            Cursor="Arrow"
            ForceCursor="True"
            PreviewMouseLeftButtonDown="DragSurface_PreviewMouseLeftButtonDown">
        <StackPanel MinWidth="150">
            <Border x:Name="TransientStatusBadge"
                    Visibility="Collapsed"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10,5"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="TransientStatusText"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold" />
            </Border>

            <StackPanel x:Name="ItemContentPanel">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ItemIcon"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,9,0"
                           VerticalAlignment="Top" />
                    <TextBlock x:Name="ItemNameText"
                               Grid.Column="1"
                               Foreground="White"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="InfoStackPanel"
                            HorizontalAlignment="Left">
                    <TextBlock x:Name="TraderPriceText" Foreground="White" />
                    <TextBlock x:Name="FleaPriceText" Foreground="White" />
                    <TextBlock x:Name="TraderSlotPriceText" Foreground="White" />
                    <TextBlock x:Name="FleaSlotPriceText" Foreground="White" />
                    <TextBlock x:Name="CurrentNeededText" Foreground="White" />
                    <TextBlock x:Name="AmmoPickupText"
                               Foreground="White"
                               FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="JunhyunHelper.Desktop.Scanner.MiniScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <Border x:Name="EditFrame"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ItemIcon"
                       Width="48"
                       Height="48"
                       Stretch="Uniform"
                       Margin="0,0,9,0"
                       VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" MinWidth="110">
                    <TextBlock x:Name="ItemNameText"
                               Foreground="White"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="TraderPriceText" Foreground="White" />
                    <TextBlock x:Name="FleaPriceText" Foreground="White" />
                    <TextBlock x:Name="TraderSlotPriceText" Foreground="White" />
                    <TextBlock x:Name="FleaSlotPriceText" Foreground="White" />
                    <TextBlock x:Name="CurrentNeededText" Foreground="White" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="EditHintText"
                       Visibility="Collapsed"
                       Text="드래그하여 위치 이동"
                       Foreground="#FFD0D0D0"
                       FontSize="11"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>

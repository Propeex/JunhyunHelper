<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerOcrSubstitutionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner OCR 문자 치환"
        Width="650"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="OCR 문자 치환"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="반복해서 확인한 OCR 오인식만 직접 등록합니다. 원본 OCR은 진단 데이터에 그대로 보존되고, 치환 결과는 아이템 이름 비교 전에 한 번만 적용됩니다. 예: 「 → r" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="사용" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="OCR에서 잘못 읽힌 문자/문자열" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="바꿀 문자/문자열" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <ListBox x:Name="RulesList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BackgroundDarkBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="32"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="→"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="32"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="추가" MinWidth="76" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button Grid.Column="1" Content="선택 삭제" MinWidth="88" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button Grid.Column="2" Content="모두 초기화" MinWidth="96" Click="ResetButton_Click" />
            <Button Grid.Column="4" Content="취소" MinWidth="76" Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="5" Content="저장" MinWidth="76" IsDefault="True" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>

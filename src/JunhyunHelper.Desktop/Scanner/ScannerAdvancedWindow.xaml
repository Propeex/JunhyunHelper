<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerAdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 고급"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Border x:Name="AdvancedContentBorder"
            Margin="14"
            Background="{StaticResource BackgroundMediumBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Scanner 고급"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="테스트와 교정 데이터 관리에 필요한 기능을 제공합니다."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,6,0,16" />

            <Button x:Name="TestToggleButton"
                    Grid.Row="2"
                    Content="테스트 스캐너 OFF"
                    Height="38"
                    Margin="0,0,0,10"
                    Click="TestToggleButton_Click" />
            <Button x:Name="ManageCorrectionsButton"
                    Grid.Row="3"
                    Content="교정 데이터 관리"
                    Height="38"
                    Margin="0,0,0,10"
                    Click="ManageCorrectionsButton_Click" />
            <Button x:Name="ExportDiagnosticsButton"
                    Grid.Row="4"
                    Content="Scanner 성능 진단 자료 내보내기"
                    Height="38"
                    Click="ExportDiagnosticsButton_Click" />

            <Button x:Name="AdvancedCloseButton"
                    Grid.Row="5"
                    Content="닫기"
                    MinWidth="84"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>

<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerHotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 단축키 설정"
        Width="560"
        Height="370"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Border Margin="14"
            Background="{StaticResource BackgroundMediumBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Scanner 단축키"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="게임 중에도 사용할 수 있는 전역 단축키입니다. 각 기능에 서로 다른 조합을 지정해 주세요."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,7,0,16" />

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="1회 인게임 스캔" VerticalAlignment="Center" />
                <TextBlock x:Name="OneShotTarkovText"
                           Grid.Column="1"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="변경"
                        MinWidth="76"
                        Click="ChangeOneShotTarkovButton_Click" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="1회 테스트 스캔" VerticalAlignment="Center" />
                <TextBlock x:Name="OneShotTestText"
                           Grid.Column="1"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="변경"
                        MinWidth="76"
                        Click="ChangeOneShotTestButton_Click" />
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="스캐너 ON/OFF" VerticalAlignment="Center" />
                <TextBlock x:Name="ScannerToggleText"
                           Grid.Column="1"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="변경"
                        MinWidth="76"
                        Click="ChangeScannerToggleButton_Click" />
            </Grid>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="취소" MinWidth="76" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button Content="저장" MinWidth="84" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

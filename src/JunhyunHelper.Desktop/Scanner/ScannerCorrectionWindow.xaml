<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 교정"
        Width="1260"
        Height="900"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The child keeps original pixel coordinates while Viewbox performs display-only
             scaling. Ground Truth rectangles therefore remain in source-image coordinates. -->
        <Border Grid.Row="0"
                Background="Black"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid x:Name="ImageCanvasHost">
                    <Image x:Name="CaptureImage" Stretch="None" />
                    <Canvas x:Name="OverlayCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                            MouseMove="OverlayCanvas_MouseMove"
                            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp" />
                </Grid>
            </Viewbox>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="CaseSummaryText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="InstructionText"
                           Text="교정할 항목을 선택한 뒤 이미지에 표시된 후보 사각형을 마우스로 클릭하세요. 후보가 없으면 직접 지정하거나 ‘없음’을 선택할 수 있습니다."
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DetailFieldButton"
                            Content="상세보기 창"
                            MinWidth="112"
                            Margin="0,0,6,0"
                            Click="DetailFieldButton_Click" />
                    <Button x:Name="CloseFieldButton"
                            Grid.Column="1"
                            Content="빨간 X"
                            MinWidth="88"
                            Margin="0,0,6,0"
                            Click="CloseFieldButton_Click" />
                    <Button x:Name="MagnifierFieldButton"
                            Grid.Column="2"
                            Content="돋보기"
                            MinWidth="88"
                            Margin="0,0,6,0"
                            Click="MagnifierFieldButton_Click" />
                    <Button x:Name="TitleFieldButton"
                            Grid.Column="3"
                            Content="아이템명 영역"
                            MinWidth="112"
                            Click="TitleFieldButton_Click" />

                    <Button x:Name="KeepCurrentButton"
                            Grid.Column="5"
                            Content="현재 검출값"
                            MinWidth="104"
                            Margin="0,0,6,0"
                            Click="KeepCurrentButton_Click" />
                    <Button x:Name="NoneButton"
                            Grid.Column="6"
                            Content="없음"
                            MinWidth="72"
                            Margin="0,0,6,0"
                            Click="NoneButton_Click" />
                    <Button x:Name="ManualButton"
                            Grid.Column="7"
                            Content="직접 지정"
                            MinWidth="92"
                            Click="ManualButton_Click" />
                </Grid>

                <TextBlock x:Name="ActiveFieldStatusText"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="정답 아이템명"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="GroundTruthTextBox"
                             Grid.Column="1"
                             MinWidth="260"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="2"
                            Content="전부 맞음"
                            MinWidth="94"
                            Margin="0,0,8,0"
                            Click="ConfirmButton_Click" />
                    <Button x:Name="SaveCorrectionButton"
                            Grid.Column="3"
                            Content="교정 저장"
                            MinWidth="104"
                            Margin="0,0,8,0"
                            Click="SaveCorrectionButton_Click" />
                    <Button Grid.Column="4"
                            Content="닫기"
                            MinWidth="84"
                            Click="CloseButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ResetCorrectionButton"
                            Content="선택 초기화"
                            MinWidth="108"
                            Margin="0,0,8,0"
                            Click="ResetCorrectionButton_Click" />
                    <TextBlock x:Name="SaveStatusText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

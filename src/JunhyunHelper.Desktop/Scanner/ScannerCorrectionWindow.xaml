<Window x:Class="JunhyunHelper.Desktop.Scanner.ScannerCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner 교정"
        Width="1260"
        Height="900"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Black"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Grid x:Name="ImageCanvasHost">
                        <Image x:Name="CaptureImage" Stretch="None" />
                        <Canvas x:Name="OverlayCanvas"
                                Background="Transparent"
                                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                                MouseMove="OverlayCanvas_MouseMove"
                                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp" />
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="CaseSummaryText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="InstructionText"
                           Text="각 영역은 Scanner가 실제 생성한 후보에서 정답을 선택하는 것이 기본입니다. 후보에 정답이 없으면 ‘직접 지정’을 선택해 이미지에서 드래그하고, 아예 검출되면 안 되는 항목은 ‘없음’을 선택하세요."
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <Border Background="{StaticResource BackgroundDarkBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="상세보기 창"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="DetailCandidateComboBox"
                                  Grid.Row="0" Grid.Column="1"
                                  Margin="0,0,18,8"
                                  SelectionChanged="CandidateComboBox_SelectionChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="빨간 X"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="CloseCandidateComboBox"
                                  Grid.Row="0" Grid.Column="3"
                                  Margin="0,0,0,8"
                                  SelectionChanged="CandidateComboBox_SelectionChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="돋보기"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="MagnifierCandidateComboBox"
                                  Grid.Row="1" Grid.Column="1"
                                  Margin="0,0,18,0"
                                  SelectionChanged="CandidateComboBox_SelectionChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="아이템명 ROI"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="TitleCandidateComboBox"
                                  Grid.Row="1" Grid.Column="3"
                                  SelectionChanged="CandidateComboBox_SelectionChanged" />
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="정답 아이템명"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="GroundTruthTextBox"
                             Grid.Column="1"
                             MinWidth="260"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="2"
                            Content="전부 맞음"
                            MinWidth="94"
                            Margin="0,0,8,0"
                            Click="ConfirmButton_Click" />
                    <Button x:Name="SaveCorrectionButton"
                            Grid.Column="3"
                            Content="교정 저장"
                            MinWidth="104"
                            Margin="0,0,8,0"
                            Click="SaveCorrectionButton_Click" />
                    <Button Grid.Column="4"
                            Content="닫기"
                            MinWidth="84"
                            Click="CloseButton_Click" />
                </Grid>

                <WrapPanel Margin="0,0,0,2">
                    <Button x:Name="DetailCorrectionButton"
                            Content="상세보기 직접 지정"
                            MinWidth="138"
                            Margin="0,0,8,6"
                            Click="DetailCorrectionButton_Click" />
                    <Button x:Name="CloseCorrectionButton"
                            Content="빨간 X 직접 지정"
                            MinWidth="132"
                            Margin="0,0,8,6"
                            Click="CloseCorrectionButton_Click" />
                    <Button x:Name="MagnifierCorrectionButton"
                            Content="돋보기 직접 지정"
                            MinWidth="132"
                            Margin="0,0,8,6"
                            Click="MagnifierCorrectionButton_Click" />
                    <Button x:Name="TitleCorrectionButton"
                            Content="아이템명 직접 지정"
                            MinWidth="138"
                            Margin="0,0,8,6"
                            Click="TitleCorrectionButton_Click" />
                    <Button x:Name="ResetCorrectionButton"
                            Content="선택 초기화"
                            MinWidth="108"
                            Margin="0,0,8,6"
                            Click="ResetCorrectionButton_Click" />
                </WrapPanel>

                <TextBlock x:Name="SaveStatusText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
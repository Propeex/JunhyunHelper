<UserControl x:Class="JunhyunHelper.Desktop.Map.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="{StaticResource BackgroundDarkBrush}"
             Loaded="MapPage_Loaded"
             Unloaded="MapPage_Unloaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="지도" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="MapComboBox" Grid.Column="1" SelectionChanged="MapComboBox_SelectionChanged" />

                <TextBlock x:Name="FloorLabel" Grid.Column="2" Text="층" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox x:Name="FloorComboBox" Grid.Column="3" DisplayMemberPath="Name"
                          SelectionChanged="FloorComboBox_SelectionChanged" />

                <Button x:Name="MiniMapButton" Grid.Column="4" Content="미니맵 켜기" Margin="12,0,0,0"
                        Click="MiniMapButton_Click" />

                <TextBlock x:Name="TrackingStatusText" Grid.Column="5" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="6" Content="스크린샷 경로" Margin="0,0,6,0" Click="ScreenshotFolderButton_Click" />
                <Button Grid.Column="7" Content="자동 찾기" Margin="0,0,6,0" Click="AutoDetectScreenshotButton_Click" />
                <Button Grid.Column="8" Content="보기 초기화" Click="ResetViewButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <CheckBox Tag="PmcExtract" Content="PMC 탈출구" Margin="5,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="ScavExtract" Content="Scav 탈출구" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="SharedExtract" Content="공용 탈출구" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="Transit" Content="Transit" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="PmcSpawn" Content="PMC 스폰" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="ScavSpawn" Content="Scav 스폰" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="SniperScav" Content="저격수" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="BossGroup" Content="보스/특수 AI" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="Quest" Content="퀘스트" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="Hazard" Content="위험 구역" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="LockSwitch" Content="잠금/스위치" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="StationaryWeapon" Content="고정 화기" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="BtrStop" Content="BTR" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="LootContainer" Content="루팅 컨테이너" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="LooseLoot" Content="루즈 루트" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="User" Content="사용자 마커" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="Player" Content="현재 위치" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <CheckBox Tag="Trail" Content="이동 경로" Margin="0,3,12,3" Checked="MarkerToggle_Changed" Unchecked="MarkerToggle_Changed" />
                <Button Content="경로 지우기" Padding="10,4" Margin="0,1,0,1" Click="ClearTrailButton_Click" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="이 지도에서 진행 중인 퀘스트" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,8" />
                    <ListBox x:Name="MapQuestList" Grid.Row="1" SelectionChanged="MapQuestList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LocationSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="OpenQuestButton" Grid.Row="2" Content="퀘스트 탭에서 보기" Margin="0,8,0,0"
                            IsEnabled="False" Click="OpenQuestButton_Click" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

            <Border Grid.Column="2" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="MapScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel"
                                  PreviewMouseLeftButtonDown="MapScrollViewer_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="MapScrollViewer_PreviewMouseLeftButtonUp"
                                  PreviewMouseMove="MapScrollViewer_PreviewMouseMove">
                        <Grid x:Name="MapSurface" Width="1600" Height="1100" Background="#16191D"
                              MouseRightButtonUp="MapSurface_MouseRightButtonUp">
                            <svgc:SvgViewbox x:Name="MapSvg" Stretch="Fill" IsHitTestVisible="False" />
                            <Canvas x:Name="ZoneCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="TrailCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="MarkerCanvas" />
                            <Canvas x:Name="UserMarkerCanvas" />
                            <Canvas x:Name="PlayerCanvas" IsHitTestVisible="False" />
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="MarkerInfoPanel" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="300" Margin="12" Padding="12"
                            Background="#EE24282E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="MarkerInfoTitle" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="×" Padding="6,2" Margin="8,0,0,0" Click="CloseMarkerInfoButton_Click" />
                            </Grid>
                            <TextBlock x:Name="MarkerInfoText" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NoMapPanel" Background="#CC16191D" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="표시할 지도 자산이 없습니다." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NoMapDetailText"
                                       Text="지도 탭에 들어오면 필요한 지도 자산을 자동으로 다시 받습니다."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Button x:Name="RetryMapAssetsButton" Content="지도 자산 다시 받기"
                                    HorizontalAlignment="Center" Padding="16,7" Margin="0,14,0,0"
                                    Click="RetryMapAssetsButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="JunhyunHelper.Desktop.Map.MiniMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:JunhyunHelper.Desktop.Map"
        Title="준현 미니맵"
        Width="300" Height="300"
        MinWidth="200" MinHeight="200"
        MaxWidth="800" MaxHeight="800"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip" Background="Transparent"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseUp="Window_PreviewMouseUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Border x:Name="MainBorder"
            Background="#88000000"
            BorderThickness="0"
            CornerRadius="0"
            ClipToBounds="True">
        <Grid x:Name="MiniViewport" Background="Transparent" ClipToBounds="True">
            <Grid x:Name="MiniSurface"
                  Width="1600" Height="1100"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  RenderTransformOrigin="0,0">
                <map:ReadableSvgViewbox x:Name="MiniSvg" Stretch="Fill" IsHitTestVisible="False" />
                <Canvas x:Name="MiniMarkerCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="MiniTrailCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="MiniPlayerCanvas" IsHitTestVisible="False" />
            </Grid>

            <Border x:Name="FloorIndicator"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8" Padding="7,4"
                    Background="#B0202020" CornerRadius="4"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FloorNameText"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="FloorModeText"
                               Text="공유" Foreground="#A0C4FF" FontSize="10" Margin="6,1,0,0" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="8" Padding="6,3"
                    Background="#B0202020" CornerRadius="4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ZoomHintText"
                           Text="플레이어 추적"
                           FontSize="10" Foreground="#C8FFFFFF" />
            </Border>

            <Path Data="M 0,12 L 12,0 M 4,12 L 12,4 M 8,12 L 12,8"
                  Stroke="#44FFFFFF" StrokeThickness="1"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,2,2" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
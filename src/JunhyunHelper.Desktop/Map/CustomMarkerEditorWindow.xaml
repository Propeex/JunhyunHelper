<Window x:Class="JunhyunHelper.Desktop.Map.CustomMarkerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용자 마커" Width="360" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="이름" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
        <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,0,0,12" />
        <TextBlock Grid.Row="2" Text="색상 (#RRGGBB)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
        <TextBox x:Name="ColorTextBox" Grid.Row="3" Text="#FFD700" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="저장" Width="80" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>

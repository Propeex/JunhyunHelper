<UserControl x:Class="JunhyunHelper.Desktop.Hideout.HideoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="StationRowTemplate">
            <Border x:Name="RowBorder"
                    MinHeight="64"
                    Padding="10,7"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="3" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0,14,0" />
                    <Border Grid.Column="2"
                            Background="{StaticResource BackgroundDarkBrush}"
                            CornerRadius="9"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LevelText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundLightBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MaterialRowTemplate">
            <Border Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="8"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38"
                            Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <TextBlock Text="?"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,10,0">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Border Visibility="{Binding InRaidVisibility}"
                                Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="6"
                                Padding="5,1"
                                HorizontalAlignment="Left"
                                Margin="0,3,0,0">
                            <TextBlock Text="인레이드"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AmountText}"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 Margin="0,0,0,10"
                 ToolTip="은신처 시설 검색"
                 TextChanged="SearchBox_TextChanged" />

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="2,0,0,10" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="420" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundMediumBrush}"
                    CornerRadius="8"
                    ClipToBounds="True">
                <ListBox x:Name="StationList"
                         ItemTemplate="{StaticResource StationRowTemplate}"
                         SelectionChanged="StationList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundMediumBrush}"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="시설을 선택하면 현재 레벨과 다음 업그레이드 정보를 확인할 수 있습니다."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />

                    <ScrollViewer x:Name="DetailScroll"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64"
                                        Height="64"
                                        Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Image x:Name="DetailIcon" Stretch="Uniform" Margin="4" />
                                </Border>
                                <TextBlock x:Name="DetailName"
                                           Grid.Column="1"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="현재 레벨"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <Border Background="{StaticResource BackgroundDarkBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6"
                                    Margin="0,0,0,18"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="LevelMinusButton"
                                            Grid.Column="0"
                                            Content="−"
                                            FontSize="18"
                                            Padding="0"
                                            Click="LevelMinusButton_Click" />
                                    <TextBlock x:Name="CurrentLevelText"
                                               Grid.Column="1"
                                               Text="Lv.0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Button x:Name="LevelPlusButton"
                                            Grid.Column="2"
                                            Content="+"
                                            FontSize="18"
                                            Padding="0"
                                            Click="LevelPlusButton_Click" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="NextLevelHeader"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <Border Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="NextLevelMessage"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,8" />
                                    <ItemsControl x:Name="NextLevelItems"
                                                  ItemTemplate="{StaticResource MaterialRowTemplate}" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ConstructionTimeText"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit direct and transitive runtime packages during restore/build. Any known
         NuGet vulnerability warning blocks a release candidate. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- The pinned Tarkov-Helper source was not authored with warnings-as-errors.
         Preserve the exact upstream Map/MiniMap source instead of modifying it merely
         to satisfy JunhyunHelper's stricter compile policy. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0067;CS4014;CS8602;CS8618;CS8625</WarningsNotAsErrors>
    <!-- Keep the C# namespace stable while making the Windows executable and assembly
         use the user-facing Korean product name. -->
    <RootNamespace>JunhyunHelper</RootNamespace>
    <AssemblyName>준현 헬퍼</AssemblyName>
    <Product>준현 헬퍼</Product>
    <Title>준현 헬퍼</Title>
    <Description>Escape from Tarkov 진행도·아이템·탄약·지도 도우미</Description>
    <Version>0.1.11</Version>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\JunhyunHelper.AppIcon.ico</ApplicationIcon>
    <!-- The product UI is Korean-only. Let the .NET SDK filter framework/package
         satellite assemblies at publish time instead of deleting files afterward. -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JunhyunHelper.Application\JunhyunHelper.Application.csproj" />
    <ProjectReference Include="..\JunhyunHelper.Infrastructure\JunhyunHelper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tarkov_data.db" />
    <Content Include="Assets\tarkov_data.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Models\**\*.cs"
             Link="Legacy\TarkovHelper\Models\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\..\vendor\Tarkov-Helper\TarkovHelper\Models\UserData.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Models\UserQuestProgress.cs" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Services\**\*.cs"
             Link="Legacy\TarkovHelper\Services\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\..\vendor\Tarkov-Helper\TarkovHelper\Services\LoggingService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\GlobalKeyboardHookService.cs" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Controls\**\*.cs"
             Link="Legacy\TarkovHelper\Controls\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Pages\Map\**\*.cs"
             Link="Legacy\TarkovHelper\Pages\Map\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\OverlayMiniMapWindow.xaml.cs"
             Link="Legacy\TarkovHelper\Windows\OverlayMiniMapWindow.xaml.cs" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\Dialogs\**\*.cs"
             Link="Legacy\TarkovHelper\Windows\Dialogs\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Utils\**\*.cs"
             Link="Legacy\TarkovHelper\Utils\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Pages\Map\MapPage.xaml"
          Link="Legacy\TarkovHelper\Pages\Map\MapPage.xaml" />
    <Page Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\OverlayMiniMapWindow.xaml"
          Link="Legacy\TarkovHelper\Windows\OverlayMiniMapWindow.xaml" />
    <Page Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\Dialogs\**\*.xaml"
          Link="Legacy\TarkovHelper\Windows\Dialogs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Assets\Maps\**\*"
          Link="Assets\Maps\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Assets\Markers\**\*"
          Link="Assets\Markers\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateAppIcon" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\GenerateApplicationIcon.ps1&quot; -SourcePng &quot;$(MSBuildProjectDirectory)\Assets\AppIcon.png&quot; -OutputIco &quot;$(ApplicationIcon)&quot;" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit direct and transitive runtime packages during restore/build. Any known
         NuGet vulnerability warning blocks a release candidate. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- The pinned Tarkov-Helper source was not authored with warnings-as-errors.
         Preserve the exact upstream Map/MiniMap source instead of modifying it merely
         to satisfy JunhyunHelper's stricter compile policy. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0067;CS4014;CS8602;CS8618;CS8625</WarningsNotAsErrors>
    <!-- Keep the C# namespace stable while making the Windows executable and assembly
         use the user-facing Korean product name. -->
    <RootNamespace>JunhyunHelper</RootNamespace>
    <AssemblyName>준현 헬퍼</AssemblyName>
    <Product>준현 헬퍼</Product>
    <Title>준현 헬퍼</Title>
    <Description>Escape from Tarkov 진행도·아이템·탄약·지도·스캐너 도우미</Description>
    <Version>1.11.2</Version>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\JunhyunHelper.AppIcon.ico</ApplicationIcon>
    <!-- The product UI is Korean-only. Let the .NET SDK filter framework/package
         satellite assemblies at publish time instead of deleting files afterward. -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="TesseractOCR" Version="5.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JunhyunHelper.Application\JunhyunHelper.Application.csproj" />
    <ProjectReference Include="..\JunhyunHelper.Infrastructure\JunhyunHelper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Services\*.cs"
             Exclude="..\..\vendor\Tarkov-Helper\TarkovHelper\Services\LocalizationService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\TarkovDataService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\UpdateService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\SettingsMigrationService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\TarkovApiService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\WikiDataService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\OverlayHotkeyService.cs;..\..\vendor\Tarkov-Helper\TarkovHelper\Services\GameWindowMonitorService.cs" Link="Vendor\TarkovHelper\Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Services\Logging\*.cs" Link="Vendor\TarkovHelper\Services\Logging\%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Services\Map\*.cs" Link="Vendor\TarkovHelper\Services\Map\%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Models\Map\*.cs" Link="Vendor\TarkovHelper\Models\Map\%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Pages\Map\MapPage.xaml.cs" Link="Vendor\TarkovHelper\Pages\Map\MapPage.xaml.cs" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\OverlayMiniMapWindow.xaml.cs" Link="Vendor\TarkovHelper\Windows\OverlayMiniMapWindow.xaml.cs" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\Dialogs\CustomMarkerEditorWindow.xaml.cs" Link="Vendor\TarkovHelper\Windows\Dialogs\CustomMarkerEditorWindow.xaml.cs" />
    <Compile Include="..\..\vendor\Tarkov-Helper\TarkovHelper\ViewModels\Map\MapMarkerViewModel.cs" Link="Vendor\TarkovHelper\ViewModels\Map\MapMarkerViewModel.cs" />
    <Page Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Pages\Map\MapPage.xaml" Link="Vendor\TarkovHelper\Pages\Map\MapPage.xaml" Generator="MSBuild:Compile" />
    <Page Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\OverlayMiniMapWindow.xaml" Link="Vendor\TarkovHelper\Windows\OverlayMiniMapWindow.xaml" Generator="MSBuild:Compile" />
    <Page Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Windows\Dialogs\CustomMarkerEditorWindow.xaml" Link="Vendor\TarkovHelper\Windows\Dialogs\CustomMarkerEditorWindow.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Assets\DB\Maps\**\*" Link="Assets\DB\Maps\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Assets\DB\Data\map_configs.json" Link="Assets\DB\Data\map_configs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Assets\DB\Data\map_markers.json" Link="Assets\DB\Data\map_markers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\Tarkov-Helper\TarkovHelper\Assets\DB\tarkov_data.db" Link="Assets\tarkov_data.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

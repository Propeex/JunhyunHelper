<UserControl x:Class="TarkovHelper.Pages.Map.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:TarkovHelper.Pages.Map"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BackgroundDarkBrush}">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageTitle" Text="지도 위치 추적기" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMapLabel" Text="지도:" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbMapSelect" Width="160" SelectionChanged="CmbMapSelect_SelectionChanged"/>
                    <TextBlock x:Name="TxtFloorLabel" Text="층:" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,8,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbFloorSelect" Width="120" SelectionChanged="CmbFloorSelect_SelectionChanged"
                              Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                    <CheckBox x:Name="ChkShowQuestMarkers" Content="퀘스트 마커"
                              Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="True" Checked="ChkShowQuestMarkers_Changed" Unchecked="ChkShowQuestMarkers_Changed"/>
                    <CheckBox x:Name="ChkShowExtractMarkers" Content="탈출구"
                              Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="True" Checked="ChkShowExtractMarkers_Changed" Unchecked="ChkShowExtractMarkers_Changed"/>
                    <CheckBox x:Name="ChkFixedView" Content="고정 뷰"
                              Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                              Checked="ChkFixedView_Changed" Unchecked="ChkFixedView_Changed"/>
                    <Button x:Name="BtnClearTrail" Content="경로 지우기" Padding="12,6" Margin="0,0,8,0" Click="BtnClearTrail_Click"/>
                    <Button x:Name="BtnFullScreen" Content="전체 화면" Padding="12,6" Margin="0,0,8,0" Click="BtnFullScreen_Click"/>
                    <Button x:Name="BtnSettings" Content="설정" Padding="12,6" Click="BtnSettings_Click"/>
                </StackPanel>
                <Button x:Name="BtnToggleTracking" Grid.Column="3" Content="추적 시작"
                        Padding="16,6" MinWidth="140" Click="BtnToggleTracking_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BackgroundLightBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="대기 중" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock x:Name="TxtPositionLabel" Text="위치:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoordinates" Text="--" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="TxtLastUpdateLabel" Text="마지막 업데이트:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtLastUpdateTime" Text="--" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QuestDrawerColumn" Width="320" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="MarkerListColumn" Width="Auto" MinWidth="0"/>
                <ColumnDefinition x:Name="SettingsColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="QuestDrawerPanel" Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}" Padding="10,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtQuestObjectivesTitle" Text="퀘스트 목표" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtMapProgressCount" Grid.Column="1" Text="0/0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="X" Grid.Column="2" Padding="6,2" Click="BtnCloseQuestDrawer_Click" Background="Transparent" BorderThickness="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                            <TextBlock x:Name="TxtMapProgressLabel" Visibility="Collapsed"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="2" Height="4">
                                    <Border x:Name="MapProgressBar" Background="{StaticResource SuccessBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                </Border>
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                                    <ComboBox x:Name="CmbStatusFilter" Width="70" Height="22" FontSize="10" Padding="3,2" Margin="0,0,4,4" SelectionChanged="CmbStatusFilter_SelectionChanged">
                                        <ComboBoxItem x:Name="CmbStatusAll" Content="전체" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem x:Name="CmbStatusIncomplete" Content="미완료" Tag="Incomplete"/>
                                        <ComboBoxItem x:Name="CmbStatusCompleted" Content="완료" Tag="Completed"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CmbTypeFilter" Width="78" Height="22" FontSize="10" Padding="3,2" Margin="0,0,4,4" SelectionChanged="CmbTypeFilter_SelectionChanged">
                                        <ComboBoxItem x:Name="CmbTypeAll" Content="전체 타입" Tag="All" IsSelected="True"/>
                                        <ComboBoxItem x:Name="CmbTypeVisit" Content="방문" Tag="visit"/>
                                        <ComboBoxItem x:Name="CmbTypeMark" Content="마크" Tag="mark"/>
                                        <ComboBoxItem x:Name="CmbTypePlant" Content="설치" Tag="plantItem"/>
                                        <ComboBoxItem x:Name="CmbTypeExtract" Content="탈출" Tag="extract"/>
                                        <ComboBoxItem x:Name="CmbTypeFind" Content="획득" Tag="findItem"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkCurrentMapOnly" FontSize="10" Margin="0,0,8,4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="True" Checked="ChkCurrentMapOnly_Changed" Unchecked="ChkCurrentMapOnly_Changed">
                                        <TextBlock x:Name="TxtCurrentMapOnly" Text="이 맵만" FontSize="10"/>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkGroupByQuest" FontSize="10" Margin="0,0,0,4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="True" Checked="ChkGroupByQuest_Changed" Unchecked="ChkGroupByQuest_Changed">
                                        <TextBlock x:Name="TxtGroupByQuest" Text="그룹" FontSize="10"/>
                                    </CheckBox>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="QuestObjectivesList" Margin="12">
                            <ItemsControl.Resources>
                                <DataTemplate x:Key="QuestGroupHeaderTemplate">
                                    <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="4" Padding="10,8" Margin="0,12,0,6" Opacity="{Binding Opacity}" BorderBrush="{Binding HeaderBrush}" BorderThickness="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding QuestName}" FontSize="17" FontWeight="Bold" Foreground="{Binding HeaderBrush}" TextDecorations="{Binding TextDecoration}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Wiki" Click="WikiLinkButton_Click" Tag="{Binding WikiLink}" Visibility="{Binding HasWikiLink, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,2" FontSize="10" Background="Transparent" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Cursor="Hand"/>
                                            <Border Grid.Column="2" Background="{Binding HeaderBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Progress}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate x:Key="QuestObjectiveTemplate">
                                    <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4" Padding="10" Margin="{Binding ItemMargin}" Cursor="Hand" BorderBrush="{Binding SelectionBorderBrush}" BorderThickness="{Binding SelectionBorderThickness}" MouseLeftButtonDown="QuestObjectiveItem_Click" IsEnabled="{Binding IsEnabled}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="ObjectiveCheckBox_Checked" Unchecked="ObjectiveCheckBox_Unchecked" Tag="{Binding Objective}" IsEnabled="{Binding IsEnabled}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding QuestName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,4" TextDecorations="{Binding TextDecoration}" Visibility="{Binding QuestNameVisibility}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="{Binding TypeBrush}" CornerRadius="3" Padding="5,2" Opacity="{Binding ContentOpacity}" VerticalAlignment="Center"><TextBlock Text="{Binding TypeDisplay}" FontSize="11" Foreground="White" FontWeight="SemiBold"/></Border>
                                                    <Border Background="{Binding FloorBrush}" CornerRadius="3" Padding="5,2" Margin="4,0,0,0" Visibility="{Binding FloorBadgeVisibility}"><TextBlock Text="{Binding FloorDisplay}" FontSize="11" Foreground="White" FontWeight="Bold"/></Border>
                                                    <Border Background="#607D8B" CornerRadius="3" Padding="5,2" Margin="4,0,0,0" Visibility="{Binding OtherMapBadgeVisibility}"><TextBlock Text="{Binding OtherMapName}" FontSize="11" Foreground="White" FontWeight="SemiBold"/></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Opacity="{Binding ContentOpacity}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplateSelector>
                                <local:QuestDrawerTemplateSelector GroupHeaderTemplate="{StaticResource QuestGroupHeaderTemplate}" ObjectiveTemplate="{StaticResource QuestObjectiveTemplate}"/>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <GridSplitter x:Name="DrawerSplitter" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Visibility="Visible" Cursor="SizeWE" ShowsPreview="True"/>
                <Button x:Name="BtnToggleDrawer" Width="16" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BackgroundLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Click="BtnToggleDrawer_Click" Cursor="Hand" Panel.ZIndex="10"><TextBlock x:Name="TxtDrawerToggleIcon" Text="&lt;&lt;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></Button>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" ClipToBounds="True">
                <Grid x:Name="MapViewerGrid" Background="Transparent" MouseLeftButtonDown="MapViewer_MouseLeftButtonDown" MouseLeftButtonUp="MapViewer_MouseLeftButtonUp" MouseMove="MapViewer_MouseMove" MouseWheel="MapViewer_MouseWheel" PreviewMouseRightButtonDown="MapViewer_PreviewMouseRightButtonDown">
                    <Grid.ContextMenu><ContextMenu x:Name="MapContextMenu"><MenuItem x:Name="MenuAddCustomMarker" Header="마커 추가" Click="MenuAddCustomMarker_Click"/></ContextMenu></Grid.ContextMenu>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" Panel.ZIndex="100" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Width="28" Height="28" Padding="0" Click="BtnZoomOut_Click" Margin="0,0,4,0" Visibility="Collapsed"/>
                            <ComboBox x:Name="CmbZoomLevel" Width="80" SelectionChanged="CmbZoomLevel_SelectionChanged" KeyDown="CmbZoomLevel_KeyDown" IsEditable="True" SelectedIndex="3" Visibility="Collapsed"/>
                            <Button Content="+" Width="28" Height="28" Padding="0" Click="BtnZoomIn_Click" Margin="4,0,4,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnResetView" Content="초기화" Padding="8,4" Click="BtnResetView_Click" Margin="4,0,0,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnMinimap" Content="미니맵" Padding="12,6" Margin="0,0,4,0" Click="BtnMinimap_Click"/>
                            <Button x:Name="BtnExitFullScreen" Content="전체 화면 종료" Padding="8,4" Click="BtnExitFullScreen_Click" Margin="4,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Canvas x:Name="MapCanvas" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Arrow">
                        <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="MapTranslate" X="0" Y="0"/></TransformGroup></Canvas.RenderTransform>
                        <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        <svgc:SvgViewbox x:Name="MapSvg" Stretch="None" Visibility="Collapsed"/>
                        <Canvas x:Name="MapMarkersContainer"/>
                        <Canvas x:Name="ExtractMarkersContainer"/>
                        <Canvas x:Name="QuestMarkersContainer"/>
                        <Canvas x:Name="CustomMarkersContainer"/>
                        <Polyline x:Name="TrailPath" Stroke="#80FF5722" StrokeThickness="2" StrokeLineJoin="Round"/>
                        <Canvas x:Name="PlayerMarker" Visibility="Collapsed">
                            <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="MarkerScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="MarkerTranslation" X="0" Y="0"/></TransformGroup></Canvas.RenderTransform>
                            <Ellipse Width="28" Height="28" Canvas.Left="-14" Canvas.Top="-14" Fill="#40FF5722"/>
                            <Ellipse Width="16" Height="16" Canvas.Left="-8" Canvas.Top="-8" Fill="#FFFF5722" Stroke="#FFFFFFFF" StrokeThickness="2"/>
                            <Path x:Name="DirectionArrow" Fill="#FFFF5722" Stroke="#FFFFFFFF" StrokeThickness="1"><Path.Data><PathGeometry><PathFigure StartPoint="0,-24" IsClosed="True"><LineSegment Point="6,-12"/><LineSegment Point="2,-12"/><LineSegment Point="2,-8"/><LineSegment Point="-2,-8"/><LineSegment Point="-2,-12"/><LineSegment Point="-6,-12"/></PathFigure></PathGeometry></Path.Data><Path.RenderTransform><RotateTransform x:Name="MarkerRotation" Angle="0" CenterX="0" CenterY="0"/></Path.RenderTransform></Path>
                        </Canvas>
                        <Canvas x:Name="PlayerDot" Visibility="Collapsed"><Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="DotTranslation" X="0" Y="0"/></TransformGroup></Canvas.RenderTransform><Ellipse Width="28" Height="28" Canvas.Left="-14" Canvas.Top="-14" Fill="#40FF5722"/><Ellipse Width="16" Height="16" Canvas.Left="-8" Canvas.Top="-8" Fill="#FFFF5722" Stroke="#FFFFFFFF" StrokeThickness="2"/></Canvas>
                    </Canvas>
                    <StackPanel x:Name="NoMapPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"><TextBlock x:Name="TxtNoMapImage" Text="사용 가능한 지도 이미지가 없습니다" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="TxtAddMapImageHint" Text="Assets/Maps/ 폴더에 이미지를 추가하세요" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock x:Name="TxtSetImagePathHint" Text="또는 설정에서 경로를 지정하세요" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <Border x:Name="MapMarkersOverlay" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" Panel.ZIndex="100" Background="#E0202020" CornerRadius="6" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock x:Name="TxtMapMarkersTitle" Text="지도 마커" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Button x:Name="BtnToggleMapMarkersPanel" Content="▼" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Padding="4,0" Margin="8,0,0,0" Click="BtnToggleMapMarkersPanel_Click"/></StackPanel><StackPanel x:Name="MapMarkersContent"><CheckBox x:Name="ChkShowPmcSpawns" Content="PMC 스폰" IsChecked="True" Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"/><CheckBox x:Name="ChkShowSniperScavs" Content="스나이퍼 스캐브" IsChecked="True" Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"/><CheckBox x:Name="ChkShowRogues" Content="로그" IsChecked="True" Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"/><CheckBox x:Name="ChkShowCultists" Content="컬티스트" IsChecked="True" Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"/><CheckBox x:Name="ChkShowLeversMarker" Content="레버" IsChecked="True" Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"/><CheckBox x:Name="ChkShowBosses" Content="보스" IsChecked="True" Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"/></StackPanel></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel" Grid.Column="5" Background="{StaticResource BackgroundMediumBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <Grid Margin="0,0,0,16"><TextBlock x:Name="TxtSettingsTitle" Text="설정" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Button Content="✕" HorizontalAlignment="Right" Padding="8,4" Click="BtnCloseSettings_Click" Background="Transparent" BorderThickness="0"/></Grid>
                    <TextBlock x:Name="TxtScreenshotFolderLabel" Text="스크린샷 폴더" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtScreenshotFolder" IsReadOnly="True" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Button x:Name="BtnAutoDetect" Content="자동 감지" Padding="12,6" Margin="0,0,8,0" Click="BtnAutoDetect_Click"/><Button x:Name="BtnBrowseFolder" Content="찾아보기" Padding="12,6" Click="BtnBrowseFolder_Click"/></StackPanel>
                    <TextBlock x:Name="TxtMarkerSettingsLabel" Text="마커 설정" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkHideCompletedObjectives" Content="완료된 목표 숨기기" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" IsChecked="False" Checked="ChkHideCompletedObjectives_Changed" Unchecked="ChkHideCompletedObjectives_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock x:Name="TxtQuestStyleLabel" Text="퀘스트 스타일:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/><ComboBox x:Name="CmbQuestMarkerStyle" Width="160" SelectionChanged="CmbQuestMarkerStyle_SelectionChanged"><ComboBoxItem x:Name="CmbStyleIconOnly" Content="아이콘 전용"/><ComboBoxItem x:Name="CmbStyleGreenCircle" Content="녹색 원"/><ComboBoxItem x:Name="CmbStyleIconWithName" Content="아이콘 + 이름"/><ComboBoxItem x:Name="CmbStyleCircleWithName" Content="원 + 이름"/></ComboBox></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock x:Name="TxtQuestNameSizeLabel" Text="퀘스트 이름:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/><Slider x:Name="SliderQuestNameTextSize" Width="120" Minimum="1" Maximum="100" Value="20" ValueChanged="SliderQuestNameTextSize_ValueChanged"/><TextBlock x:Name="TxtQuestNameTextSize" Text="20" Width="30" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock x:Name="TxtQuestMarkerSizeLabel" Text="퀘스트 마커:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/><Slider x:Name="SliderMarkerSize" Width="120" Minimum="1" Maximum="100" Value="18" ValueChanged="SliderMarkerSize_ValueChanged"/><TextBlock x:Name="TxtMarkerSize" Text="18" Width="30" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><TextBlock x:Name="TxtPlayerMarkerSizeLabel" Text="플레이어 마커:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/><Slider x:Name="SliderPlayerMarkerSize" Width="120" Minimum="1" Maximum="100" Value="18" ValueChanged="SliderPlayerMarkerSize_ValueChanged"/><TextBlock x:Name="TxtPlayerMarkerSize" Text="18" Width="30" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <TextBlock x:Name="TxtExtractSettingsLabel" Text="탈출구 설정" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkShowPmcExtracts" Content="PMC 탈출구" Foreground="#4CAF50" FontWeight="SemiBold" Margin="0,0,0,6" IsChecked="True" Checked="ChkExtractFilter_Changed" Unchecked="ChkExtractFilter_Changed"/>
                    <CheckBox x:Name="ChkShowScavExtracts" Content="Scav 탈출구" Foreground="#FF9800" FontWeight="SemiBold" Margin="0,0,0,6" IsChecked="True" Checked="ChkExtractFilter_Changed" Unchecked="ChkExtractFilter_Changed"/>
                    <CheckBox x:Name="ChkShowTransitExtracts" Content="트랜짓 탈출구" Foreground="#2196F3" FontWeight="SemiBold" Margin="0,0,0,12" IsChecked="True" Checked="ChkExtractFilter_Changed" Unchecked="ChkExtractFilter_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><TextBlock x:Name="TxtExtractNameSizeLabel" Text="이름 크기:" Foreground="{StaticResource TextSecondaryBrush}" Width="100"/><Slider x:Name="SliderExtractTextSize" Width="120" Minimum="8" Maximum="24" Value="16" ValueChanged="SliderExtractTextSize_ValueChanged"/><TextBlock x:Name="TxtExtractTextSize" Text="16" Width="30" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <TextBlock x:Name="TxtMarkerColorsLabel" Text="마커 색상" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border x:Name="ColorVisit" Width="24" Height="24" Background="#4CAF50" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="visit"/><TextBlock x:Name="TxtColorVisit" Text="방문" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border x:Name="ColorMark" Width="24" Height="24" Background="#FF9800" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="mark"/><TextBlock x:Name="TxtColorMark" Text="마크" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border x:Name="ColorPlant" Width="24" Height="24" Background="#9C27B0" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="plantItem"/><TextBlock x:Name="TxtColorPlant" Text="설치" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border x:Name="ColorExtract" Width="24" Height="24" Background="#2196F3" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="extract"/><TextBlock x:Name="TxtColorExtract" Text="탈출" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border x:Name="ColorFind" Width="24" Height="24" Background="#FFEB3B" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="findItem"/><TextBlock x:Name="TxtColorFind" Text="획득" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/></StackPanel>
                    <Button x:Name="BtnResetColors" Content="색상 초기화" FontSize="11" Padding="8,4" Margin="0,8,0,0" Click="BtnResetColors_Click" HorizontalAlignment="Left"/>
                </StackPanel></ScrollViewer>
            </Border>

            <Grid Grid.Column="3"><GridSplitter Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" ShowsPreview="True"/></Grid>
            <Border x:Name="MarkerListPanel" Grid.Column="4" Background="{StaticResource BackgroundMediumBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="MarkerListContentColumn" Width="280"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnToggleCustomMarkersPanel" Grid.Column="0" Width="16" VerticalAlignment="Stretch" Padding="0" Background="{StaticResource BackgroundLightBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}" Click="BtnToggleCustomMarkersPanel_Click" Cursor="Hand"><TextBlock x:Name="TxtToggleIcon" Text="◀" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/></Button>
                    <Grid Grid.Column="1" x:Name="MarkerListContentGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}" Padding="12,10"><StackPanel><TextBlock Text="커스텀 마커 목록" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="TxtMarkerOpacityLabel" Text="투명도:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Width="65"/><Slider x:Name="SliderMarkerOpacity" Width="130" Minimum="0" Maximum="100" Value="100" ValueChanged="SliderMarkerOpacity_ValueChanged"/><TextBlock x:Name="TxtMarkerOpacity" Text="100%" Width="40" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
                        <ListView x:Name="LstCustomMarkers" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="LstCustomMarkers_SelectionChanged">
                            <ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0" Fill="{Binding Color}" Stroke="White" StrokeThickness="0.5"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding FloorId}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Visibility="{Binding FloorId, Converter={StaticResource NullToVisibilityConverter}}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="✏️" Width="24" Height="24" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Click="BtnEditMarker_Manual_Click" Tag="{Binding}"/><Button Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#FF4444" BorderThickness="0" Click="BtnDeleteMarker_Manual_Click" Tag="{Binding}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
